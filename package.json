{
  "name": "vite-min-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:supply": "node --test src/entities/supply/lib/calculations.test.mjs src/entities/supply/lib/report.test.mjs",
    "test:inventory": "node --test src/entities/inventory/lib/inventory.test.mjs",
    "test:orders": "node --test src/entities/order/lib/calculations.test.mjs",
    "test:guest": "node --test src/entities/order/lib/guest-order.test.mjs",
    "test:architecture": "node --test scripts/architecture.test.mjs scripts/backend-boundaries.test.mjs",
    "test:analytics": "node --experimental-strip-types --test src/widgets/dependency-graph/model/*.test.mjs",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs src/entities/*/lib/*.test.mjs src/widgets/dependency-graph/model/*.test.mjs",
    "desktop:dev": "node scripts/desktop-icons.cjs && concurrently --kill-others --success command-ELECTRON --names VITE,ELECTRON \"vite --host 127.0.0.1 --port 5174 --strictPort\" \"wait-on --timeout 60000 http-get://127.0.0.1:5174 && node electron/dev.cjs\"",
    "desktop:build": "node scripts/desktop-icons.cjs && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@gfazioli/mantine-qr-code": "^2.0.13",
    "@mantine/charts": "^9.7.2",
    "@mantine/core": "^9.7.2",
    "@mantine/dates": "^9.7.2",
    "@mantine/form": "^9.7.2",
    "@mantine/hooks": "^9.7.2",
    "@mantine/notifications": "^9.7.2",
    "@reduxjs/toolkit": "^2.13.0",
    "@tabler/icons-react": "^3.49.0",
    "@xyflow/react": "^12.12.0",
    "d3-force": "^3.0.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.cjs",
  "description": "STOQ — управление рестораном",
  "build": {
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "appId": "app.stoq.desktop",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/protocol.cjs",
      "package.json",
      "!node_modules/**/*",
      "build/icon.png"
    ],
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "nsis": {
      "oneClick": false,
      "createDesktopShortcut": true,
      "perMachine": false,
      "runAfterFinish": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true
    },
    "productName": "STOQ",
    "electronDist": "node_modules/electron/dist"
  }
}
