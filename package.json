{
  "name": "vite-min-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:supply": "node --test src/entities/supply/lib/calculations.test.mjs src/entities/supply/lib/report.test.mjs",
    "test:inventory": "node --test src/entities/inventory/lib/inventory.test.mjs",
    "test:orders": "node --test src/entities/order/lib/calculations.test.mjs",
    "test:guest": "node --test src/entities/order/lib/guest-order.test.mjs",
    "test:architecture": "node --test scripts/architecture.test.mjs scripts/backend-boundaries.test.mjs",
    "test": "node --test scripts/*.test.mjs src/entities/*/lib/*.test.mjs"
  },
  "dependencies": {
    "@gfazioli/mantine-qr-code": "^2.0.13",
    "@mantine/core": "^9.7.1",
    "@mantine/dates": "^9.7.1",
    "@mantine/form": "^9.7.1",
    "@mantine/hooks": "^9.7.1",
    "@mantine/notifications": "^9.7.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@tabler/icons-react": "^3.49.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postcss": "^8.5.29",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
